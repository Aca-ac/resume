# Copy to .env and adjust before docker compose up
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-resume
MYSQL_USER=resume
MYSQL_DATABASE=resume_assistant

REDIS_PASSWORD=change-me-redis

JWT_SECRET=change-me-use-at-least-32-characters-long-random-string

# Comma-separated origins for CORS (production)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

OPENAI_API_KEY=
# 阿里云 DashScope（图片 OCR 必填）
DASHSCOPE_API_KEY=
QWEN_API_KEY=
# 可选，默认 qwen-vl-ocr
QWEN_OCR_MODEL=qwen-vl-ocr
# 可选
QWEN_WORKSPACE_ID=

# Email Configuration
EMAIL_USERNAME=your-email@example.com
EMAIL_PASSWORD=your-email-password
